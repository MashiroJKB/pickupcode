<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 严格遵循隐私原则：100% 纯本地离线解析与存储，绝不声明 INTERNET 权限 -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- 短信读取与新短信广播接收权限 -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- 桌面角标通知与各主流国产系统桌面角标权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.hihonor.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" />
    <uses-permission android:name="com.oppo.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.oppo.launcher.permission.WRITE_SETTINGS" />
    <uses-permission android:name="com.oplus.notification.permission.BADGE_DIGITAL" />
    <uses-permission android:name="com.vivo.notification.permission.BADGE_ICON" />

    <!-- Android 11+ 包可见性声明：用于直接唤起淘宝/拼多多 DeepLink -->
    <queries>
        <package android:name="com.taobao.taobao" />
        <package android:name="com.xunmeng.pinduoduo" />
    </queries>

    <application
        android:name=".PickupApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PickupCode"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 新短信到达广播接收器 -->
        <receiver
            android:name=".service.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 桌面液态玻璃小组件 -->
        <receiver
            android:name=".widget.PickupWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.pickupcode.widget.ACTION_LAUNCH_TAOBAO" />
                <action android:name="com.example.pickupcode.widget.ACTION_LAUNCH_CAINIAO" />
                <action android:name="com.example.pickupcode.widget.ACTION_LAUNCH_PINDUODUO" />
                <action android:name="com.example.pickupcode.widget.ACTION_ITEM_CLICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pickup_widget_info" />
        </receiver>

        <service
            android:name=".widget.PickupWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

</manifest>
